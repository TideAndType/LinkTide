{
  "name": "linktide",
  "version": "0.1.0",
  "description": "Local-first backlink discovery, citation management, and guarded directory submission for macOS.",
  "author": {
    "name": "Tide & Type Co.",
    "url": "https://tideandtype.com"
  },
  "private": true,
  "main": "dist/desktop/main.cjs",
  "scripts": {
    "dev": "pnpm --filter @linktide/dashboard dev",
    "worker": "pnpm --filter @linktide/worker serve",
    "worker:doctor": "pnpm --filter @linktide/worker doctor",
    "typecheck": "pnpm -r typecheck",
    "build:dashboard": "pnpm --filter @linktide/dashboard build",
    "build:desktop": "pnpm build:dashboard && esbuild apps/desktop/src/main.ts --bundle --platform=node --format=cjs --target=node22 --outfile=dist/desktop/main.cjs --external:electron --external:playwright",
    "desktop:dev": "pnpm build:desktop && electron .",
    "desktop:pack": "pnpm build:desktop && electron-builder --config electron-builder.config.cjs --mac --dir",
    "desktop:dmg": "pnpm build:desktop && electron-builder --config electron-builder.config.cjs --mac --universal --publish never"
  },
  "dependencies": {
    "playwright": "latest"
  },
  "devDependencies": {
    "electron": "latest",
    "electron-builder": "^26.0.0",
    "esbuild": "latest",
    "typescript": "latest"
  },
  "packageManager": "pnpm@12.8.1"
}
