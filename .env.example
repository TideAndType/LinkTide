# LM Studio / Cloudflare Tunnel
LM_STUDIO_BASE_URL=https://your-tunnel.example.com/v1
LM_STUDIO_MODEL=your-loaded-model
LM_STUDIO_API_KEY=

# Web search provider
BRAVE_SEARCH_API_KEY=
LINKTIDE_SEARCH_MAX_QUERIES=8
LINKTIDE_SEARCH_RESULTS_PER_QUERY=10

# Local Playwright worker
LINKTIDE_WORKER_PORT=4317
LINKTIDE_BROWSER_PROFILE=./browser-profile
LINKTIDE_HEADLESS=false
LINKTIDE_AUTO_SUBMIT=false
# Required only when a non-local dashboard should call the local worker.
LINKTIDE_DASHBOARD_ORIGIN=

# App
LINKTIDE_DATA_DIR=./data
